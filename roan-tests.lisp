(in-package :roan/test)

(in-readtable :roan+interpol)

(defparameter *jump-change-coverage-maximum-stage* 6)

(defun extent (stage)
  (when (eql stage 2)
    (return-from extent '(!12 !21)))
  (iter (with subextent := (extent (- stage 1)))
        (with 1cycle := (first (parse-place-notation (format nil "(1~A)"
                                                             (bell-name (- stage 1)))
                                                     :stage stage)))
        (for ncycle :initially 1cycle :then (permute ncycle 1cycle))
        (repeat stage)
        (nconcing (iter (for r :in subextent)
                        (collect (permute r ncycle))))))

(define-test test-roan-syntax ()
  (let ((*readtable* (copy-readtable nil)))
    (assert-true (symbolp (read-from-string "!13248765")))
    (roan-syntax)
    (assert-true (rowp (read-from-string "!13248765")))
    (roan-syntax nil)
    (assert-true (symbolp (read-from-string "!13248756")))
    (roan-syntax t t)
    (assert-true (rowp (read-from-string "!13248756")))
    (roan-syntax nil)
    (assert-true (symbolp (read-from-string "!13247865")))))

(define-test test-use-roan ()
  (let* ((absent (intern "TEST-RINGING-PACKAGE-NOT-PRESENT-SYMBOL"))
         (p (make-package (format nil "TEST-RINGING-PACKAGE-TEST-PACKAGE~A" (random 1.0))
                          :use '(:cl)))
         (*readtable* (copy-readtable nil)))
    (assert-false (find-symbol (symbol-name 'parse-place-notation) p)
    (assert-false (find-symbol (symbol-name absent) p))
    (assert-true (symbolp '!13248765))
    (assert-true (use-roan :package p))
    (assert-true (find-symbol (symbol-name 'parse-place-notation) p))
    (assert-false (find-symbol (symbol-name absent) p))
    (assert-true (rowp '!13248765))
    (assert-eq 'parse-place-notation (find-symbol (symbol-name 'parse-place-notation) p))
    (assert-false (use-roan :package p))))
  (assert-error 'package-error (use-roan :package :keyword)))

(define-test test-bells ()
  (assert-typep 'bell 0)
  (assert-typep 'bell 1)
  (assert-typep 'bell 8)
  (assert-typep 'bell 23)
  (assert-false (typep 24 'bell))
  (assert-false (typep -1 'bell))
  (assert-false (typep #\1 'bell))
  (assert-false (typep "1" 'bell))
  (assert-false (typep '|1| 'bell))
  (assert-false (typep :1 'bell))
  (assert-false (typep 1.0 'bell))
  (assert-false (typep 'treble 'bell))
  (assert-false (typep nil 'bell))
  (assert-eql #\8 (bell-name 7))
  (assert-eql #\1 (bell-name 0))
  (assert-eql #\E (bell-name 10))
  (assert-eql #\T (bell-name 11))
  (assert-eql #\N (bell-name 23))
  (assert-eql #\8 (bell-name 7 nil))
  (assert-eql #\1 (bell-name 0 nil))
  (assert-eql #\e (bell-name 10 nil))
  (assert-eql #\t (bell-name 11 nil))
  (assert-eql #\n (bell-name 23 nil))
  (let ((*print-bells-upper-case* nil))
