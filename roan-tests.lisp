(define-test test-place-notation-writing ()
  (flet ((test-write-place-notation (expected changes &rest keys &key &allow-other-keys)
           (let (result)
             (assert-prints expected
                             (setf result (apply #'write-place-notation changes keys)))
             (assert-eq changes result))))
    (with-sink-stream
      (test-write-place-notation "#8!x3.4" #8!x3.4)
      (test-write-place-notation "#7!(13).3" #7!(13).3)
      (test-write-place-notation "#7!(13).3" #7![2315476][2135476])
      (test-write-place-notation "#7!(13).3" #7!(13).3 :jump-changes :jumps)
      (test-write-place-notation "#7!(13).3" #7![2315476][2135476] :jump-changes :jumps)
      (test-write-place-notation "#7![2315476]3" #7!(13).3 :jump-changes :full)
      (test-write-place-notation "#7![2315476]3" #7![2315476][2135476] :jump-changes :full)
      (assert-error 'error (write-place-notation #7!(13).3 :jump-changes nil))
      (assert-error 'error (write-place-notation #7![2315476][2135476] :jump-changes nil))
      (test-write-place-notation "#8!x3.4" #8!x3.4 :jump-changes nil)
      (assert-error 'type-error (write-place-notation #8!x3.4 :jump-changes :foo))
      (assert-prints "" (assert-error 'type-error (write-place-notation #12!x3.4 :jump-changes :foo)))
      (assert-prints "" (assert-error 'error (write-place-notation #12!(13) :jump-changes nil)))
      (test-write-place-notation "x3.4" #6!x3.4 :escape nil)
      (test-write-place-notation "#8!x3.4" #8!x3.4)
      (test-write-place-notation "#6!x3x4x2" #6!x3-4X2)
      (test-write-place-notation "#6!x3x4x2" #6!x3-4X2 :cross #\x)
      (test-write-place-notation "#6!x3x4x2" #6!x3-4X2 :cross :|x|)
      (test-write-place-notation "#6!x3x4x2" #6!x3-4X2 :cross '|x|)
      (test-write-place-notation "#6!x3x4x2" #6!x3-4X2 :cross "x")
      (test-write-place-notation "#6!X3X4X2" #6!x3-4X2 :cross #\X)
      (test-write-place-notation "#6!X3X4X2" #6!x3-4X2 :cross "X")
      (test-write-place-notation "#6!X3X4X2" #6!x3-4X2 :cross :X)
      (test-write-place-notation "#6!X3X4X2" #6!x3-4X2 :cross 'X)
      (test-write-place-notation "#6!-3-4-2" #6!x3-4X2 :cross #\-)
      (test-write-place-notation "#6!-3-4-2" #6!x3-4X2 :cross "-")
      (test-write-place-notation "#6!-3-4-2" #6!x3-4X2 :cross :-)
      (test-write-place-notation "#6!-3-4-2" #6!x3-4X2 :cross '-)
      (assert-error 'type-error (write-place-notation #6!x3-4X2 :cross nil))
      (assert-error 'type-error (write-place-notation #6!x3-4X2 :cross #\z))
      (assert-error 'type-error (write-place-notation #6!x3-4X2 :cross ""))
      (assert-error 'type-error (write-place-notation #6!x3-4X2 :cross "xx"))
      (assert-error 'type-error (write-place-notation #6!x3-4X2 :cross :cross))
      (assert-error 'error (write-place-notation nil))
      (assert-error 'error (write-place-notation (append #6!x3x4 #8!x5x36)))
      (assert-error 'error (place-notation-string nil))
      (assert-error 'error (place-notation-string (append #6!x3x4 #8!x5x36)))
      (test-write-place-notation "#16!1.E.T.A.B.C.D" #16!1.E.t.A.b.C.d)
      (test-write-place-notation "#16!1.E.T.A.B.C.D" #16!1.E.t.A.b.C.d :upper-case t)
      (test-write-place-notation "#16!1.e.t.a.b.c.d" #16!1.E.t.A.b.C.d :upper-case nil)
      (assert-equality #'string= "3.1.5"
                       (with-output-to-string (s)
                         (write-place-notation #11!3.1.5 :stream s :escape nil)))
      (assert-equality #'string= "#11!3.1.5"
                       (with-output-to-string (s)
                         (write-place-notation #11!3.1.5 :stream s :escape t)))
      (test-write-place-notation "#8!45.1x4x56x8" #8!1458.1x4x56x1)
      (test-write-place-notation "#8!45.18x4x56x18" #8!1458.1x4x56x1 :elide :interior)
      (test-write-place-notation "#8!45.8x4x56x8" #8!1458.1x4x56x1 :elide :leading)
      (test-write-place-notation "#8!45.1x4x56x1" #8!1458.1x4x56x1 :elide :lying)
      (test-write-place-notation "#8!45.1x4x56x8" #8!1458.1x4x56x1 :elide :lead-end)
      (dolist (k '(nil :interior :leading :lying :lead-end))
        (test-write-place-notation "#7!1.3.345.367.7" #7!1.3.345.367.7 :elide k))
      (assert-equality #'string= "x3.4.(13)(46).1.T"
                       (place-notation-string #12!x3T.14.(13)(46).1.t))
      (assert-equality #'string= "-3.4.(13)(46).1.1"
                       (place-notation-string #12!x3T.14.(13)(46).1.t
                                              :elide :lying :upper-case nil :cross #\-))
      (test-write-place-notation "#6!x3x4x5,2" #6!x3x4x5,2 :comma t)
      (test-write-place-notation "x3x4x5,2" #6!x3x4x5,2 :comma t :escape nil)
      (test-write-place-notation "#6!x3x4x5x4x3x2" #6!x3x4x5,2)
      (test-write-place-notation "X3tX14X5t,12" #12!x3x4x5,2
                                 :comma t :upper-case nil :cross :X :elide nil :escape nil)
      (test-write-place-notation "#8!1.(13).(13)2(31)(48)5(84),1.(36)(63)"
                                 #8!1[23154768][32185764],8[21654387] :comma t)
      (test-write-place-notation "#5!3.123" #5!3,123 :comma t)
      (test-write-place-notation "#8!4x3x2x1x2x3x8" #8!4x3x2x1x2x3x1 :comma t)
      (test-write-place-notation "#8!4" #8!4 :comma t)
      (test-write-place-notation "#6!x3x(24)x2x(35)x4x5x4x(53)x2x(42)x3x2"
                                 #6!x3x(24)x2x(35)x4x5,2)
      (test-write-place-notation "#6!x3x(24)x2x(35)x4x5,2" #6!x3x(24)x2x(35)x4x5,2 :comma t)
      (test-write-place-notation "#6!x3x(24)x2x(35)x4x(13)45x4x(53)x2x(42)x3x2"
                                 #6!x3x(24)x2x(35)x4x(13)45x4x(53)x2x(42)x3x2 :comma t)
      (test-write-place-notation "#6!x3x[134265]x2x[214536]x4x5,2" #6!x3x(24)x2x(35)x4x5,2
                                 :comma t :jump-changes :full))))

(defun random-changes (stage count)
  (iter (repeat count)
        (collect (apply #'row (shuffle (iter (for i :from 0 :below stage)
                                             (collect i)))))))

(define-test test-jump-change-coverage ()
  (flet ((round-trip (c)
           (equalp c (first (parse-place-notation (place-notation-string (list c))
                                                  :stage (stage c))))))
    (assert-true (every #'round-trip
                        (iter (for i :from 2 :to *jump-change-coverage-maximum-stage*)
                              (appending (extent i)))))
    (assert-true (every #'round-trip
                        (iter (for stage
                                   :from (+ *jump-change-coverage-maximum-stage* 1)
                                   :to +maximum-stage+)
                              (appending (random-changes stage 100)))))))

(define-test test-canonicalize-place-notation ()
  (let ((pn "-5.-14..5Tx5.30.4x.70.1t.36-9.30.8-18.9t-18-T,1"))
    (assert-equal "x5x4.5x5.30.4x70.1.36x9.30.8x8.9x8x1,T"
                  (canonicalize-place-notation pn :stage 12))
    (let ((*default-stage* 12))
      (assert-equal "X5X4.5X5.30.4X70.1t.36X9.30.8X8.9X8X1t,1t"
                    (canonicalize-place-notation pn  :cross #\X :upper-case nil :elide :interior)))))

