(define-test test-generate-rows ()
  (labels ((test-gen-once (fn start changes result &optional skip-optional)
             (unless (or start skip-optional)
               (assert-equalp result (multiple-value-list (funcall fn changes))))
             (let ((x (multiple-value-list (funcall fn  changes start))))
               (assert-equalp result x)
               x))
           (test-gen (start changes result-1 result-2)
             (test-gen-once #'generate-rows start changes (list result-1 result-2))
             (test-gen-once #'generate-rows start (coerce changes 'vector)
                            (list (coerce result-1 'vector) result-2))
             (let ((c (copy-seq changes)))
               (test-gen-once #'ngenerate-rows start c (list result-1 result-2) t))
             (let ((c (copy-seq changes)))
               (assert-eq c
                          (first (test-gen-once #'ngenerate-rows start c
                                                (list result-1 result-2) t))))
             (test-gen-once #'ngenerate-rows start (coerce changes 'vector)
                            (list (coerce result-1 'vector) result-2) t)
             (let ((v (coerce changes 'vector)))
               (assert-eq v
                          (first (test-gen-once #'ngenerate-rows start v
                                                (list (coerce result-1 'vector)
                                                      result-2)
                                                t))))))
    (test-gen nil #6!x1x4 '(!123456 !214365 !241635 !426153) !462135)
    (test-gen nil #6!x1[345612]4 '(!123456 !214365 !241635 !163524) !136542)
    (test-gen !25314 #5!1 '(!25314) !23541)
    (let ((*default-stage* 8))
      (test-gen nil nil nil !2345678))
    (test-gen !7654321 nil nil !7654321)
    (test-gen !123456978 #4!x1,2
              '(!123456978 !214356978 !241356978 !423156978) !421356978))
  (assert-error 'type-error (generate-rows #8!x3x4x5x6 "12345678"))
  (assert-error 'type-error (generate-rows '(!214365 "213465" !132546)))
  (assert-error 'type-error (generate-rows (coerce #8!x3x4x5x6 'vector) "12345678"))
  (assert-error 'type-error (generate-rows #(!214365 "213465" !132546)))
  (assert-error 'type-error (ngenerate-rows #8!x3x4x5x6 "12345678"))
  (assert-error 'type-error (ngenerate-rows '(!214365 "213465" !132546)))
  (assert-error 'type-error (ngenerate-rows (coerce #8!x3x4x5x6 'vector) "12345678"))
  (assert-error 'type-error (ngenerate-rows #(!214365 "213465" !132546))))

