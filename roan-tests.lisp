(define-test test-row-predicates ()
  (assert-true (roundsp !23456789))
  (iter (for i :from +minimum-stage+ :to +maximum-stage+)
        (assert-true (roundsp (rounds i))))
  (assert-false (roundsp !1234567890ETACBD))
  (assert-false (roundsp !213))
  (assert-false (roundsp !132))
  (assert-false (roundsp :foo))
  (assert-false (roundsp nil))
  (assert-true (changep !213546))
  (assert-false (changep !214536))
  (assert-false (changep :foo))
  (assert-true (in-course-p !21354678))
  (assert-false (in-course-p !13254768))
  (assert-true (in-course-p !1542637890))
  (assert-true (in-course-p !51234))
  (assert-false (in-course-p !612345))
  (iter (for i :from +minimum-stage+ :to +maximum-stage+)
        (assert-true (in-course-p (rounds i))))
  (assert-false (in-course-p !21))
  (assert-false (in-course-p !612345))
  (assert-false (in-course-p nil))
  (assert-false (in-course-p "foo"))
  (iter (for (row parity) :in +rows-and-parities+)
        (assert-eq parity (in-course-p row)))
  (iter (for i :from +minimum-stage+ :to +maximum-stage+)
        (assert-true (involutionp (rounds i))))
  (assert-true (involutionp !213456))
  (assert-true (involutionp !132456))
  (assert-true (involutionp !123465))
  (assert-true (involutionp !623451))
  (assert-true (involutionp !2135476))
  (assert-true (involutionp !87654321))
  (assert-true (involutionp !E0987654321))
  (assert-false (involutionp !2315476))
  (assert-false (involutionp !2145376))
  (assert-false (involutionp !2143756))
  (assert-false (involutionp !13572468))
  (assert-false (involutionp nil))
  (assert-false (involutionp "foo"))
  (iter (for (row nil) :in +rows-and-parities+)
        (for prod := (permute row row))
        (if (roundsp prod)
            (assert-true (involutionp row))
            (assert-false (involutionp row)))))

(define-test test-placesp ()
  (iter (for i :from 4 :to 24 :by 2)
        (assert-true (placesp (first (parse-place-notation "34" :stage i)) 2 3))
        (assert-true (placesp (first (parse-place-notation "34" :stage i)) 3 2))
        (assert-true (placesp (first (parse-place-notation "3" :stage i)) 2 (- i 1)))
        (assert-false (placesp (first (parse-place-notation "3" :stage i))))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 0))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 1))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 0 1))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 0 1 2 3)))
  (iter (for i :from 5 :to 23 :by 2)
        (assert-true (placesp (first (parse-place-notation "3" :stage i)) 2))
        (assert-false (placesp (first (parse-place-notation "3" :stage i))))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 0))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 1))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 3))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 4))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 0 1 2))
        (assert-false (placesp (first (parse-place-notation "3" :stage i)) 2 3 4)))
  (assert-true (placesp (first #12!4589) 0 3 4 7 8 11))
  (assert-true (placesp (first #12!4589) 11 8 7 4 3 0))
  (assert-true (placesp (first #12!4589) 8 0 4 3 7 11))
  (assert-true (placesp (first #12!4589) 3 0 8 11 4 7))
  (assert-false (placesp (first #12!4589) 3 0 11 4 7))
  (assert-false (placesp (first #12!4589) 3 0 8 4 7))
  (assert-false (placesp (first #12!4589) 3 8 11 4 7))
  (assert-false (placesp (first #12!4589)))
  (assert-error 'type-error (placesp "21354768" 2 7))
  (assert-error 'type-error (placesp nil))
  (assert-error 'type-error (placesp !21354768 2.0 7))
  (assert-error 'type-error (placesp !21354768 7.0))
  (assert-error 'type-error (placesp !21354768 nil))
  (assert-error 'type-error (placesp !21354768 -1))
  (assert-error 'type-error (placesp !21354768 +maximum-stage+))
  (assert-error 'error (placesp !2135476 7))
  (assert-error 'error (placesp !21354768 3 7 3)))

(define-test test-inverse ()
  (assert-equalp !2345678901 (inverse !0123456789))
  (assert-equalp !15263748 (inverse !13572468))
  (assert-true (iter (for r :in '(!35627418 !4321 !1234 !13579E24680T !3216549870 !3126450987))
                     (always (equalp r (inverse (inverse r))))))
  (assert-true (iter (for r :in '(!123 !1234567890ETABCD !987654321))
                     (always (equalp r (inverse r)))))
  (assert-true (iter (for r :in '(!132 !4312 !BACDET0967854312))
                     (always (and (roundsp (permute r (inverse r)))
                                  (roundsp (permute (inverse r) r))))))
  (assert-error 'error (inverse "foo")))

(define-test test-permute-by-inverse ()
  (let ((rows '(!12345 !21453 !7531246 !23456781 !3254876 !3456789012TEABCDMNLKJGHF
                !321 !3421 !4571236 !214365978 !13245678E90 !25719T34608E)))
    (dolist (r1 rows)
      (dolist (r2 rows)
        (assert-equalp (permute r1 (inverse r2)) (permute-by-inverse r1 r2)))))
  (assert-error 'type-error (permute-by-inverse nil !1234))
  (assert-error 'type-error (permute-by-inverse !1234 nil))
  (assert-error 'type-error (permute-by-inverse nil nil))
  (assert-error 'type-error (permute-by-inverse "2345" !1234))
  (assert-error 'type-error (permute-by-inverse !1234 "7654321")))

(define-test test-order ()
  (iter (for stage :from +minimum-stage+ :to +maximum-stage+)
        (assert-eql 1 (order (rounds stage)))
        (assert-eql 2 (order (permute (rounds stage) !21))))
  (iter (with pb := (rounds 8))
        (repeat 6)
        (assert-eql 7 (order (setf pb (permute pb !13527486)))))
  (assert-eql 2 (order !132))
  (assert-eql 2 (order !1324567890ET))
  (assert-eql 2 (order !1324876590TE))
  (assert-eql 3 (order !13572468))
  (assert-eql 21 (order !13527486E90T))
  (assert-eql 4 (order !2413658709E))
  (assert-eql 12 (order !31426578E90))
  (assert-eql 30 (order !5123476089))
  (assert-eql 30 (order !5123476089TE))
  (assert-eql 60 (order !215439678B0ETAJCDFGH))
  (assert-eql 420 (order !215349678B0ETAJKCDFGH))
  (assert-eql 30 (order !14567890ET32))
  (assert-eql 12 (order !234567890ET1))
  (assert-eql 12 (order !T1234567890E))
  (assert-error 'type-error (order nil))
  (assert-error 'type-error (order :foo))
  (assert-error 'type-error (order 12345))
  (assert-error 'type-error (order "12345"))
  (assert-error 'type-error (order #(1 2 3)))
  (assert-error 'type-error (order '(1 2 3))))

(define-test test-cycles ()
  (assert-equal '((0 1) (2) (3 5 4)) (cycles !213564))
  (let ((rounds (cycles (rounds 18))))
    (assert-eql 18 (length rounds))
    (assert-true (every #'(lambda (x) (eql (length x) 1)) rounds))))

(define-test test-tenors-fixed-p ()
  (iter (for i :from +minimum-stage+ :below +maximum-stage+)
        (for rounds := (rounds i))
        (for x := (permute rounds !1234576))
        (dotimes (i +maximum-stage+)
          (assert-true (tenors-fixed-p rounds i))
          (assert-true (xor (<= i 6) (tenors-fixed-p x i))))
        (assert-true (tenors-fixed-p rounds))
        (assert-false (tenors-fixed-p x))
        (assert-true rounds (+ +maximum-stage+ 1))
        (assert-true rounds(+ +maximum-stage+ 10000))
        (assert-true x (+ +maximum-stage+ 1)))
  (assert-error 'type-error (tenors-fixed-p nil))
  (assert-error 'type-error (tenors-fixed-p nil 4))
  (assert-error 'type-error (tenors-fixed-p !132456 nil))
  (assert-error 'type-error (tenors-fixed-p !132456 -1))
  (assert-error 'type-error (tenors-fixed-p "132456")))

(define-test test-alter-stage ()
  (iter (with *default-stage* := 8)
        (for i :from +minimum-stage+ :below +maximum-stage+)
        (for rounds := (rounds i))
        (for x := (permute rounds !1234576))
        (iter (for i :from +minimum-stage+ :below +maximum-stage+)
              (assert-equalp (rounds i) (alter-stage rounds i))
              (if (< i 7)
                  (assert-false (alter-stage x i))
                  (assert-equalp (permute (rounds i) !234576) (alter-stage x i))))
        (assert-equalp (rounds 8) (alter-stage rounds))
        (assert-equalp !12345768 (alter-stage x)))
  (assert-false (alter-stage !1234567980ET))
  (assert-error 'type-error (alter-stage nil))
  (assert-error 'type-error (alter-stage nil 4))
  (assert-error 'type-error (alter-stage !132456 nil))
  (assert-error 'type-error (alter-stage !132456 (- +minimum-stage+ 1)))
  (assert-error 'type-error (alter-stage !132456 (+ +maximum-stage+ 1)))
  (assert-error 'type-error (alter-stage "132456")))

(define-test test-which-plain-bob-lead-head ()
  (labels ((test-stage (stage first)
               (iter (for i :from 1 :below (- stage 1))
                     (for row :initially first :then (permute row first))
                     (assert-eql i (which-plain-bob-lead-head row))
                     (assert-false (which-plain-bob-lead-head (permute row !21)))
                     (assert-false (which-plain-bob-lead-head (permute row !1243))))))
    (test-stage 4 !342)
    (test-stage 5 !3524)
    (test-stage 6 !35264)
    (test-stage 7 !352746)
    (test-stage 8 !3527486)
    (test-stage 12 !3527496E8T0)
    (test-stage 22 !13527496E8A0CTFBHDKGMJNL))
  (assert-false (which-plain-bob-lead-head !132))
  (iter (for i :from +minimum-stage+ :to +maximum-stage+)
        (assert-false (which-plain-bob-lead-head (rounds i))))
  (let ((e (extent 6)))
    (iter (repeat 5)
          (for p :initially !135264 :then (permute p !135264))
          (deletef e p :test #'equalp))
    (assert-true (notany #'which-plain-bob-lead-head e)))
  (assert-error 'type-error (which-plain-bob-lead-head nil))
  (assert-error 'type-error (which-plain-bob-lead-head 13527486))
  (assert-error 'type-error (which-plain-bob-lead-head "13527486")))

(define-test test-which-grandsire-lead-head ()
  (labels ((test-stage (stage first)
               (iter (for i :from 1 :below (- stage 2))
                     (for row :initially first :then (permute row first))
                     (assert-eql i (which-grandsire-lead-head row))
                     (assert-false (which-grandsire-lead-head (permute row !21)))
                     (assert-false (which-grandsire-lead-head (permute row !1243))))))
    (test-stage 4 !243)
    (test-stage 5 !2534)
    (test-stage 7 !253746)
    (test-stage 8 !2537486)
    (test-stage 13 !2537496E8A0T)
    (test-stage 21 !12537496E8A0CTFBHDKGJ))
  (assert-false (which-plain-bob-lead-head !1243))
  (iter (for i :from +minimum-stage+ :to +maximum-stage+)
        (assert-false (which-grandsire-lead-head (rounds i))))
  (let ((e (extent 6)))
    (iter (repeat 4)
          (for g :initially !125364 :then (permute g !125364))
          (deletef e g :test #'equalp))
    (assert-true (notany #'which-grandsire-lead-head e)))
  (assert-error 'type-error (which-grandsire-lead-head nil))
  (assert-error 'type-error (which-grandsire-lead-head 13527486))
  (assert-error 'type-error (which-grandsire-lead-head "13527486")))

(define-test test-place-notation-parsing ()
  (flet ((assert-pairwise-equalp (&rest args)
           (iter (for (x y) :on args)
                 (while y)
                 (assert-equalp x y))))
    (assert-pairwise-equalp '(!21436587 !21354768 !21436587 !13246587)
                            #8!x3.x.4
