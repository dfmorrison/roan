    (assert-eql (bell-name 10) #\e)
    (assert-eql (bell-name 11) #\t)
    (assert-eql (bell-name 23) #\n))
  (assert-false (bell-name -1))
  (assert-false (bell-name 24))
  (assert-false (bell-name nil))
  (assert-false (bell-name :1))
  (assert-false (bell-name '|1|))
  (assert-eql (bell-from-name #\1) 0)
  (assert-eql (bell-from-name #\8) 7)
  (assert-eql (bell-from-name #\0) 9)
  (assert-eql (bell-from-name #\o) 9)
  (assert-eql (bell-from-name #\O) 9)
  (assert-eql (bell-from-name #\E) 10)
  (assert-eql (bell-from-name #\e) 10)
  (assert-eql (bell-from-name #\N) 23)
  (assert-eql (bell-from-name "8") 7)
  (assert-eql (bell-from-name :8) 7)
  (assert-eql (bell-from-name '|8|) 7)
  (assert-false (bell-from-name "eight"))
  (assert-false (bell-from-name :eight))
  (assert-false (bell-from-name :treble))
  (assert-false (bell-from-name #\-))
  (assert-false (bell-from-name #\x))
  (assert-false (bell-from-name #\X))
  (assert-false (bell-from-name #\.))
  (assert-false (bell-from-name #\[))
  (assert-false (bell-from-name #\]))
  (assert-false (bell-from-name #\?))
  (assert-false (bell-from-name #\*))
  (assert-false (bell-from-name #\())
  (assert-false (bell-from-name #\)))
  (assert-false (bell-from-name #\i))
  (assert-false (bell-from-name #\I))
